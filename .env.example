# PostgreSQL
POSTGRES_USER=apigateway
POSTGRES_PASSWORD=apigateway123
POSTGRES_DB=apigateway
DATABASE_URL=postgresql://apigateway:apigateway123@localhost:5432/apigateway?schema=public

# Redis (rate limiting backend; leave empty to use in-memory fallback)
REDIS_URL=redis://localhost:6379

# JWT
# Generate a fresh secret: openssl rand -hex 32
JWT_SECRET=change-me-please-use-a-long-random-value-32-chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Services
PORT=8080
API_SERVICE_PORT=8081
API_SERVICE_URL=http://localhost:8081
WEB_PORT=5173

# CORS
ALLOWED_ORIGINS=*

# Rate limits (requests/day; 0 = unlimited)
LIMIT_FREE=100
LIMIT_PRO=10000
LIMIT_ENTERPRISE=0

# GitHub OAuth (optional)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/github/callback