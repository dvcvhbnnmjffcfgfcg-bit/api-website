{
  "name": "@api-website/api-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && echo 'gateway typechecked'",
