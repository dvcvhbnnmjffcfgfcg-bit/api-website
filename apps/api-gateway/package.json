    "@api-website/shared": "workspace:*",
    "@prisma/client": "^6.2.1",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
